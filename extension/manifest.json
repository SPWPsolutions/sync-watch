{
  "manifest_version": 3,
  "name": "Wooper's Party",
  "version": "1.3.0",
  "description": "Wooper's Party — Watch Netflix, Crunchyroll, Disney+, Hulu, Max, Prime Video, Paramount+, YouTube, and MovieBox Pro in sync with friends.",
  "minimum_chrome_version": "111",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://www.crunchyroll.com/*",
    "https://www.disneyplus.com/*",
    "https://www.hulu.com/*",
    "https://play.max.com/*",
    "https://www.amazon.com/*",
    "https://www.primevideo.com/*",
    "https://www.paramountplus.com/*",
    "https://www.youtube.com/*",
    "https://www.movieboxpro.app/*",
    "https://movieboxpro.app/*",
    "https://watch.pwlive.fyi/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.crunchyroll.com/*",
        "https://www.disneyplus.com/*",
        "https://www.hulu.com/*",
        "https://play.max.com/*",
        "https://www.amazon.com/*",
        "https://www.primevideo.com/*",
        "https://www.paramountplus.com/*",
        "https://www.youtube.com/*",
        "https://www.movieboxpro.app/*",
        "https://movieboxpro.app/*"
      ],
      "js": [
        "shared/keyguard.js",
        "shared/invite.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "netflix/injected.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.disneyplus.com/*"
      ],
      "js": [
        "disney/injected.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube/injected.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.movieboxpro.app/*",
        "https://movieboxpro.app/*"
      ],
      "js": [
        "movieboxpro/injected.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "shared/socket.js",
        "shared/sync.js",
        "shared/media.js",
        "shared/party.js",
        "shared/chat.js",
        "netflix/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.crunchyroll.com/*"
      ],
      "js": [
        "shared/socket.js",
        "shared/sync.js",
        "shared/media.js",
        "shared/party.js",
        "shared/chat.js",
        "crunchyroll/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.disneyplus.com/*"
      ],
      "js": [
        "shared/socket.js",
        "shared/sync.js",
        "shared/media.js",
        "shared/party.js",
        "shared/chat.js",
        "disney/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.hulu.com/*"
      ],
      "js": [
        "shared/socket.js",
        "shared/sync.js",
        "shared/media.js",
        "shared/party.js",
        "shared/chat.js",
        "hulu/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://play.max.com/*"
      ],
      "js": [
        "shared/socket.js",
        "shared/sync.js",
        "shared/media.js",
        "shared/party.js",
        "shared/chat.js",
        "max/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.primevideo.com/*"
      ],
      "js": [
        "shared/socket.js",
        "shared/sync.js",
        "shared/media.js",
        "shared/party.js",
        "shared/chat.js",
        "amazon/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.paramountplus.com/*"
      ],
      "js": [
        "shared/socket.js",
        "shared/sync.js",
        "shared/media.js",
        "shared/party.js",
        "shared/chat.js",
        "paramount/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "shared/socket.js",
        "shared/sync.js",
        "shared/media.js",
        "shared/party.js",
        "shared/chat.js",
        "youtube/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.movieboxpro.app/*",
        "https://movieboxpro.app/*"
      ],
      "js": [
        "shared/socket.js",
        "shared/sync.js",
        "shared/media.js",
        "shared/party.js",
        "shared/chat.js",
        "movieboxpro/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://watch.pwlive.fyi/*",
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*"
      ],
      "js": [
        "site/detect.js"
      ],
      "run_at": "document_start"
    }
  ]
}
